 "hook": {
  "en": "Japan made 80% of the world's silk.",
  "ja": "日本のシルクが世界を支えていた",
  "dur": 5.5,
  "loc": "Tomioka Silk Mill · 富岡製糸場"
 },
 "cues": [
  {
   "s": 3.3,
   "e": 10.7,
   "en": "Back then, silk was 40% of Japan's entire exports.",
   "ja": "シルクは日本の総輸出の4割"
  },
  {
   "s": 10.7,
   "e": 16.3,
   "en": "And this is where it all started.",
   "ja": "その原点がここ"
  },
  {
   "s": 16.6,
   "e": 24.2,
   "en": "When the mill closed, one family business protected it — for 18 years.",
   "ja": "閉鎖後も片倉が18年間守り続けた"
  },
  {
   "s": 24.4,
   "e": 29.0,
   "en": "Zero income. They still paid the taxes and salaries.",
   "ja": "収入ゼロでも税金も給料も自費で"
  },
  {
   "s": 29.3,
   "e": 35.6,
   "en": "Nobody knows Japanese silk overseas — just like back then.",
   "ja": "当時と同じ 世界はまだ知らない"
  },
  {
   "s": 35.6,
   "e": 41.3,
