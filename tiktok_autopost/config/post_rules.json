{
  "_comment": "動画ゲートとAPI設定。コードを触らずにここだけ更新できる。",

  "require_portrait": true,
  "min_side_px": 360,
  "max_side_px": 4096,
  "min_duration_sec": 3,
  "max_duration_sec": 600,
  "min_fps": 23,
  "max_fps": 60,
  "max_file_bytes": 4294967296,

  "_transcode_comment": "ゲート落ちのうち解像度/fps/容量だけが理由のものを自動で再エンコードする設定。横動画と尺超過は対象外。",
  "transcode_enabled": true,
  "transcode_target_long_side_px": 1920,
  "transcode_target_fps": 30,
  "transcode_crf": 20,

  "privacy_level": "PUBLIC_TO_EVERYONE",
  "disable_comment": false,
  "disable_duet": false,
  "disable_stitch": false,
  "video_cover_timestamp_ms": 1000,
  "is_aigc": false,

  "status_poll_interval_sec": 10,
  "status_poll_max_attempts": 30
}
